# Copy to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1

RAG_TOP_K=3
RAG_CANDIDATE_K=20
# 低于此重排分数直接拒答；用 eval/run_cnooc_eval.py 报告中的阈值扫描校准
RAG_MIN_RERANK_SCORE=0.3
# structured（按条款，默认）或 page（按页）；修改后需 python index_documents.py
RAG_CHUNKER=structured
RAG_MAX_TOP_K=10
RAG_MAX_QUESTION_LENGTH=2000
LOG_LEVEL=INFO
